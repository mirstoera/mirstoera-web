{
  "name": "@momera/database",
  "version": "1.0.0",
  "description": "MOMÉRA Database Schemas, Adapters, Migrations, and Repositories",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b || node -e \"console.log('Using precompiled database package')\"",
    "clean": "rm -rf dist",
    "migrate": "node dist/migrations/runner.js",
    "seed": "node dist/seeds/runner.js"
  },
  "dependencies": {
    "@momera/shared": "*",
    "better-sqlite3": "^11.1.2",
    "drizzle-orm": "^0.33.0",
    "typescript": "^5.4.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11"
  }
}
